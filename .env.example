# Optional bind/log settings. Use PORT=3001 if 3000 is occupied.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Required: local-only Docker credentials; use a managed URL with TLS when hosted.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/linkboard
# Required: separate random values, at least 32 characters for production.
ADMIN_API_KEY=replace-with-a-long-random-string
IP_HASH_SALT=replace-with-another-random-string
LOG_LEVEL=info
