{
  "name": "linkboard-service",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API for public profile links and click-event analytics.",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:integration": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "security:scan": "node scripts/secret-scan.mjs"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
